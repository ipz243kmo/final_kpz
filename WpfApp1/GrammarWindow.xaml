<Window x:Class="WpfApp1.GrammarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grammar Lessons"
        Height="620"
        Width="850"
        Background="#EEF3F9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Стиль карток -->
        <Style x:Key="TenseCard" TargetType="Button">

            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                                CornerRadius="25"
                                Background="{TemplateBinding Background}">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="3"
                                                  Opacity="0.3"/>
                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <!-- click animation -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->
        <TextBlock Text="Choose Grammar Tense"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>


        <!-- Картки -->
        <UniformGrid Grid.Row="1"
                     Rows="2"
                     Columns="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">


            <Button Style="{StaticResource TenseCard}"
                    Background="#4FC3F7"
                    Content="Present Simple"
                    Click="PresentSimple_Click"/>

            <Button Style="{StaticResource TenseCard}"
                    Background="#66BB6A"
                    Content="Present Continuous"
                    Click="PresentContinuous_Click"/>

            <Button Style="{StaticResource TenseCard}"
                    Background="#FFA726"
                    Content="Past Simple"
                    Click="PastSimple_Click"/>

            <Button Style="{StaticResource TenseCard}"
                    Background="#AB47BC"
                    Content="Future Simple"
                    Click="FutureSimple_Click"/>

        </UniformGrid>


        <!-- Нижні кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="Back"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="Back_Click"/>

            <Button Content="Save Progress"
                    Width="140"
                    Height="38"
                    Click="SaveProgress_Click"/>

        </StackPanel>

    </Grid>
</Window>