<Window x:Class="WpfApp1.ReadingExerciseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading Exercise"
        Width="850" Height="750"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="14"
                                SnapsToDevicePixels="True"
                                Effect="{DynamicResource DropShadowEffect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="DropShadowEffect" Color="Gray" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
    </Window.Resources>

    <StackPanel Margin="20" x:Name="MainPanel">

        <!-- Заголовок -->
        <TextBlock Text="Reading" 
                   FontSize="42" 
                   FontWeight="Bold" 
                   Foreground="#1E88E5" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- Текст для читання -->
        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="18" Padding="25" Margin="0,0,0,30" 
                Effect="{DynamicResource DropShadowEffect}">
            <TextBlock x:Name="EnglishText" FontSize="20" TextWrapping="Wrap"/>
        </Border>

        <!-- Вибір типу завдання -->
        <TextBlock Text="Select Exercise Type:" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30" x:Name="TaskTypePanel" >
            <Button x:Name="EngToUkrBtn" Content="English → Ukrainian" Width="260" Height="150" Margin="12" Click="TaskType_Click"/>
            <Button x:Name="UkrToEngBtn" Content="Ukrainian → English" Width="260" Height="150" Margin="12" Click="TaskType_Click"/>
            <Button x:Name="TextQuestionBtn" Content="Text-based Question" Width="260" Height="150" Margin="12" Click="TaskType_Click"/>
        </StackPanel>

        <!-- Панель для вибору текстів (Text 1 – Text 4) -->
        <WrapPanel x:Name="TextSelectionPanel" Margin="0,0,0,10" HorizontalAlignment="Center" Visibility="Collapsed"/>

        <!-- Поле для введення перекладу -->
        <TextBox x:Name="TranslationBox" Height="150" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Visibility="Collapsed"/>

        <!-- Панель вправ -->
        <StackPanel x:Name="ExercisePanel" Visibility="Collapsed">
            <Border x:Name="ExplanationBorder" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,10,0,10" 
                    Visibility="Collapsed" Effect="{DynamicResource DropShadowEffect}">
                <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" FontSize="16"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="CheckButton" Content="Check" Width="160" Height="45" Margin="10" Click="Check_Click" 
                        Background="#43A047" Foreground="White" FontWeight="SemiBold"/>
                <Button x:Name="NextButton" Content="Next" Width="160" Height="45" Margin="10" Click="NextButton_Click" Visibility="Hidden" 
                        Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>