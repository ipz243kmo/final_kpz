<Window x:Class="WpfApp1.UkrToEngExerciseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ukrainian → English Exercise"
        Width="1300" Height="700"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="20">
        <!-- Заголовок -->
        <TextBlock Text="Ukrainian → English Translation" 
                   FontSize="36" 
                   FontWeight="Bold" 
                   Foreground="#1E88E5"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Панель вибору тексту -->
        <WrapPanel x:Name="TextSelectionPanel" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Український текст -->
        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <TextBlock x:Name="UkrainianTextBlock" FontSize="18" TextWrapping="Wrap"/>
        </Border>

        <!-- Поле для введення перекладу -->
        <!-- Поле для введення перекладу з плейсхолдером -->
        <Grid Margin="0,0,0,15">
            <TextBox x:Name="TranslationBox" Height="150" FontSize="16" TextWrapping="Wrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="TranslationPlaceholder" Text="Введіть свій переклад англійською"
               FontSize="16" Foreground="Gray" Margin="5,5,0,0"
               IsHitTestVisible="False"
               VerticalAlignment="Top"
               Padding="3"/>
        </Grid>

        <!-- Панель кнопок -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="CheckButton" Content="Check" Width="140" Height="45" Margin="10" Click="CheckButton_Click"
                    Background="#43A047" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="SaveButton" Content="Save" Width="140" Height="45" Margin="10" Click="SaveButton_Click"
                    Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="BackButton" Content="Back" Width="140" Height="45" Margin="10" Click="BackButton_Click"
                    Background="#F44336" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Панель для прикладу перекладу -->
        <Border x:Name="ExplanationBorder" Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="12"
                Padding="12" Visibility="Collapsed" Margin="0,0,0,10">
            <TextBlock x:Name="ExplanationTextBlock" FontSize="16" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</Window>