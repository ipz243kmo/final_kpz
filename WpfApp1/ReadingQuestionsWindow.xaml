<Window x:Class="WpfApp1.ReadingQuestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading Questions" Height="600" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TextTitle" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="QuestionsPanel" VerticalAlignment="Top"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Завершити" Height="40" Width="150" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Finish_Click"/>
    </Grid>
</Window>