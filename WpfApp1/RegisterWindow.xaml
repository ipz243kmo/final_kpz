<Window x:Class="WpfApp1.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F2F2F2">
        <Border Width="380"
                Padding="25"
                Background="White"
                CornerRadius="10"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Реєстрація"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Ім'я користувача"/>
                <TextBox x:Name="NameTextBox"
                         Height="35"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Логін"/>
                <TextBox x:Name="LoginTextBox"
                         Height="35"
                         Margin="0,5,0,10"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="35"
                             Margin="0,5,0,10"/>

                <TextBlock Text="Підтвердження пароля"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="35"
                             Margin="0,5,0,20"/>

                <Button Content="Зареєструватися"
                        Height="40"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,0,0,10"
                        Click="RegisterButton_Click"/>

                <Button Content="Повернутися до входу"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2196F3"
                        FontWeight="Bold"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="BackButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>