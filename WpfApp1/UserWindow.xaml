<Window x:Class="WpfApp1.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профіль користувача"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F6">

    <Grid x:Name="MainGrid" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва картка -->
        <Border Grid.Column="0"
                Background="White"
                CornerRadius="15"
                Padding="20"
                Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">

                <!-- Аватар -->
                <Border Width="160" Height="160" CornerRadius="80" BorderThickness="2" BorderBrush="#4CAF50" Margin="0,0,0,15">
                    <Image x:Name="UserImage" Stretch="UniformToFill"/>
                </Border>

                <Button Content="Змінити фото"
                        Width="140" Height="35"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"
                        Margin="0,0,0,25"
                        Click="UploadPhoto_Click"/>

                <!-- Логін -->
                <TextBlock Text="Логін" Foreground="Gray" FontSize="12"/>
                <TextBlock x:Name="LoginText" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Рівень -->
                <TextBlock Text="Рівень англійської" Foreground="Gray" FontSize="12"/>
                <TextBlock x:Name="LevelText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ProgressBar x:Name="LevelProgress" Height="18" Width="200" Minimum="0" Maximum="10" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- Права частина -->
        <StackPanel x:Name="RightPanel" Grid.Column="1">

            <TextBlock Text="Статистика навчання" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <UniformGrid Columns="3" Margin="0,0,0,30" HorizontalAlignment="Stretch">

                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="📘 Уроки" FontSize="14" Foreground="Gray"/>
                        <TextBlock x:Name="LessonsText" Text="2 успішно" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,15,0">
                    <StackPanel>
                        <TextBlock Text="⏱ Час" FontSize="14" Foreground="Gray"/>
                        <TextBlock x:Name="TimeText" Text="00:12:37" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⭐ Прогрес" FontSize="14" Foreground="Gray"/>
                        <TextBlock x:Name="ProgressText" Text="Добрий" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Кнопки дій -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                <Button Content="Визначити рівень" Width="197" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold" Click="DetermineLevel_Click" Margin="0,0,10,0"/>
                <Button Content="Почати навчання" Width="183" Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="StartLearning_Click" Margin="0,0,10,0"/>
                <Button Content="Вивчення правил" Width="192" Height="40" Background="#FF9800" Foreground="White" FontWeight="Bold" Click="StudyTheory_Click"/>
            </StackPanel>

            <Button Content="Вийти з акаунту"
                    Width="160" Height="40"
                    Background="#E53935" Foreground="White" FontWeight="Bold"
                    Click="Logout_Click"/>
        </StackPanel>
    </Grid>
</Window>