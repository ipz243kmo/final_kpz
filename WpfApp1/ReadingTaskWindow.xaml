<Window x:Class="WpfApp1.ReadingTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading Task" Height="600" Width="800" WindowStartupLocation="CenterOwner"
        Background="#f0f4f8" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Стан 1: вибір тексту -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TextSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10" />
        </ScrollViewer>

        <!-- Стан 2: показ тексту -->
        <Grid x:Name="TextDisplayGrid" Grid.Row="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" 
                    Effect="{DynamicResource DropShadowEffect}" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="EnglishTextBox" TextWrapping="Wrap" IsReadOnly="True" FontSize="16" 
                             Background="White" BorderThickness="0" FontFamily="Segoe UI"/>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="1" Content="Перейти до завдань" Height="45" Width="220" 
                    HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand"
                    FontWeight="Bold" FontSize="16" Foreground="White"
                    Background="{DynamicResource GradientButtonBrush}" BorderThickness="0"
                    Click="GoToExercises_Click">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Ресурси для градієнтів та тіней -->
        <Grid.Resources>
            <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF6B8E23" Offset="0.0"/>
                <GradientStop Color="#FF556B2F" Offset="1.0"/>
            </LinearGradientBrush>

            <DropShadowEffect x:Key="DropShadowEffect" Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
        </Grid.Resources>
    </Grid>
</Window>