<Window x:Class="WpfApp1.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lesson" Height="700" Width="900" Background="#f0f4f8"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Верхня панель -->
            <RowDefinition Height="*"/>
            <!-- Картки слів -->
            <RowDefinition Height="Auto"/>
            <!-- Нижня панель -->
        </Grid.RowDefinitions>

        <!-- Верхня панель для вибору теми та дій -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Select Topic:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox x:Name="SubTopicComboBox" Width="200" Height="30" 
                      SelectionChanged="SubTopicComboBox_SelectionChanged"
                      VerticalAlignment="Center"
                      Background="White" BorderBrush="Gray" BorderThickness="1"
                      Padding="5"/>

            <Button Content="Show Unlearned" Width="150" Height="30" Margin="15,0,0,0"
                    Click="ShowUnlearned_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"/>

            <Button Content="Play Game" Width="150" Height="30" Margin="10,0,0,0"
                    Click="PlayGame_Click"
                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Основна область для карток слів -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="WordCardsPanel" Margin="0" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- Нижня панель кнопок -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="Back" Width="120" Height="35" Margin="0,0,10,0"
                    Click="Back_Click"
                    Background="#FF5722" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    DockPanel.Dock="Left"/>

            <Button Content="Save Progress" Width="150" Height="35"
                    Click="SaveProgress_Click"
                    Background="#673AB7" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    DockPanel.Dock="Left"/>
        </DockPanel>
    </Grid>
</Window>