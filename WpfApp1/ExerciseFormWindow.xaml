<Window x:Class="WpfApp1.ExerciseFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exercise" Height="900" Width="1450"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <!-- Верхні кнопки Back / Save -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="BackButton" Content="Back" Width="100" Height="35" Margin="5" Click="BackButton_Click"
                    Background="#E53935" Foreground="White"/>
            <Button x:Name="SaveButton" Content="Save" Width="100" Height="35" Margin="5" Click="SaveButton_Click"
                    Background="#43A047" Foreground="White"/>
        </StackPanel>

        <!-- Вибір тексту -->
        <TextBlock Text="Select a text:" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
        <WrapPanel x:Name="TextSelectionPanel" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Англійський текст -->
        <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,10">
            <TextBlock x:Name="EnglishTextBlock" TextWrapping="Wrap" FontSize="16"/>
        </Border>

        <!-- Поле для введення перекладу -->
        <TextBox x:Name="TranslationBox" Height="150" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

        <!-- Кнопка Check -->
        <Button x:Name="CheckButton" Content="Check Translation" Width="180" Height="40"
                HorizontalAlignment="Center" Click="CheckButton_Click"
                Background="#2196F3" Foreground="White" FontWeight="SemiBold"/>

        <!-- Панель для відображення перекладу -->
        <Border x:Name="ExplanationBorder" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="14" Padding="15"
                Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ExplanationTextBlock" TextWrapping="Wrap" FontSize="16"/>
        </Border>
    </StackPanel>
</Window>