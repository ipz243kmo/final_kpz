<Window x:Class="WpfApp1.GrammarExerciseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grammar Exercise"
        Height="800"
        Width="950"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="30">

        <!-- Заголовок -->
        <TextBlock Text="Grammar Exercise"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Прогрес і рахунок -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Прогрес:" FontSize="16" Foreground="#555"/>
            <TextBlock x:Name="ProgressText" FontSize="16" FontWeight="Bold" Foreground="#1E88E5" Margin="5,0,20,0"/>
            <TextBlock Text="Правильних:" FontSize="16" Foreground="#555"/>
            <TextBlock x:Name="ScoreText" FontSize="16" FontWeight="Bold" Foreground="#43A047" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Текст завдання -->
        <Border Background="White"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,20">
            <TextBlock x:Name="SentenceText"
                       FontSize="22"
                       Foreground="#222"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Drop Zone -->
        <Border x:Name="DropZone"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="10"
                Height="100"
                Padding="10"
                HorizontalAlignment="Center"
                AllowDrop="True"
                Margin="0,0,0,20"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
            <TextBlock Text="Перетягніть слово сюди"
                       FontSize="18"
                       Foreground="#888"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Варіанти слів -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Height="80"
                      Margin="0,0,0,20">
            <WrapPanel x:Name="WordsPanel"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       ItemHeight="Auto"
                       ItemWidth="Auto"
                       Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="CheckButton"
                    Content="Перевірити"
                    Width="160"
                    Height="50"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,20,0"
                    Background="#4CAF50"
                    Foreground="White"
                    Click="Check_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="NextButton"
                    Content="Наступне"
                    Width="160"
                    Height="50"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#2196F3"
                    Foreground="White"
                    Visibility="Hidden"
                    Click="NextButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2196F3"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <!-- Результат та пояснення -->
        <Border x:Name="ExplanationBorder"
        Background="Transparent"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="10"
        Padding="15"
        Margin="0,0,0,20"
        Visibility="Collapsed">
            <TextBlock x:Name="ExplanationText"
               FontSize="16"
               Foreground="#222"
               TextWrapping="Wrap"/>
        </Border>
        <!-- Результат та пояснення -->
        <TextBlock x:Name="ResultText"
                   FontSize="16"
                   Foreground="#555"
                   TextWrapping="Wrap"
                   MaxWidth="700"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

    </StackPanel>
</Window>